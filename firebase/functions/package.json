{
  "name": "meditest-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && npx firebase-tools emulators:start --only functions",
    "deploy": "npm run build && npx firebase-tools deploy --only functions",
    "logs": "npx firebase-tools functions:log",
    "admin:set": "node scripts/set-admin-claim.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5",
    "nodemailer": "^8.0.11",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
