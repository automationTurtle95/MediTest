rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /catalogTests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /thematicTests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      function ownsUserData() {
        return signedIn() && request.auth.uid == userId;
      }

      allow read: if ownsUserData();
      allow write: if false;

      match /settings/{document=**} {
        allow read, write: if ownsUserData();
      }

      match /documents/{document=**} {
        allow read, write: if ownsUserData();
      }

      match /testSessions/{document=**} {
        allow read, write: if ownsUserData();
      }

      match /meta/{document=**} {
        allow read, write: if ownsUserData();
      }

      match /billing/{document=**} {
        allow read: if ownsUserData();
        allow write: if false;
      }
    }

    match /licenses/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /deviceActivations/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /termsAcceptances/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /appConfig/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /customers/{userId} {
      function ownsStripeData() {
        return signedIn() && request.auth.uid == userId;
      }

      allow read: if ownsStripeData();
      allow write: if false;

      match /checkout_sessions/{document=**} {
        allow read: if ownsStripeData();
        allow write: if false;
      }

      match /subscriptions/{document=**} {
        allow read: if ownsStripeData();
        allow write: if false;
      }

      match /payments/{document=**} {
        allow read: if ownsStripeData();
        allow write: if false;
      }
    }

    match /products/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
