<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <Version>5.0.1</Version>
    <AssemblyVersion>5.0.1.0</AssemblyVersion>
    <FileVersion>5.0.1.0</FileVersion>
    <InformationalVersion>5.0.1</InformationalVersion>
    <ApplicationIcon>assets\MediTest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="release\**" />
    <Content Remove="dist\**" />
    <Content Remove="docs\**" />
    <Content Remove="scripts\**" />
    <None Remove="release\**" />
    <None Remove="dist\**" />
    <None Remove="docs\**" />
    <None Remove="scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>
</Project>
