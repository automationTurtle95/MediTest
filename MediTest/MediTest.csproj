<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <Version>5.0.12</Version>
    <AssemblyVersion>5.0.12.0</AssemblyVersion>
    <FileVersion>5.0.12.0</FileVersion>
    <InformationalVersion>5.0.12</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Meduvalo</Product>
    <AssemblyTitle>Meduvalo</AssemblyTitle>
    <Description>Meduvalo ist eine Lernsoftware für Medizinstudenten zur prüfungsnahen Vorbereitung.</Description>
    <Company>Lukas Hofer</Company>
    <ApplicationIcon>assets\MediTest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="release\**" />
    <Content Remove="dist\**" />
    <Content Remove="docs\**" />
    <Content Remove="scripts\**" />
    <None Remove="release\**" />
    <None Remove="dist\**" />
    <None Remove="docs\**" />
    <None Remove="scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.28" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
