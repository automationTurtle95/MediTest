<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>4.0.8</Version>
    <AssemblyVersion>4.0.8.0</AssemblyVersion>
    <FileVersion>4.0.8.0</FileVersion>
    <InformationalVersion>4.0.8</InformationalVersion>
    <ApplicationIcon>assets\MediTest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="release\**" />
    <Content Remove="dist\**" />
    <Content Remove="docs\**" />
    <Content Remove="scripts\**" />
    <None Remove="release\**" />
    <None Remove="dist\**" />
    <None Remove="docs\**" />
    <None Remove="scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>
</Project>
